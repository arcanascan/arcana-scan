
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "arcana-scan",
    "main": "./worker.js",
    "compatibility_date": "2026-10-06",

    "assets": {
        "directory": "./",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "arcana-forja-db",
            "database_id": "31c25707-770d-4e5d-b620-67570d77f6ac"
        }
    ],

    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true,
            "persist": true
        }
    }
}
